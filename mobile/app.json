{
  "expo": {
    "name": "Remote Control",
    "slug": "remote-control",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070707",
          "image": "./assets/splash/alien-splash.png",
          "imageWidth": 128,
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "local.remote-control.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the desktop pairing QR code to connect to your Mac.",
        "NSPhotoLibraryUsageDescription": "Choose an image to use as a custom shortcut icon."
      }
    },
    "android": {
      "package": "local.remotecontrol.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash/alien-splash.png",
        "backgroundColor": "#070707"
      },
      "permissions": ["CAMERA"],
      "edgeToEdgeEnabled": true
    }
  }
}
