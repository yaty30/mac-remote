{
  "name": "remote-control-mobile",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "index.js",
  "scripts": {
    "start": "expo start --host lan",
    "ios": "expo start --host lan --ios",
    "android": "expo start --host lan --android",
